# Secrets — never commit credentials, tokens, cookies, certs or keys.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*cookies*
*token*

# Data (databases and raw response archives stay local)
data/*.db
data/*.db-journal
data/raw/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/
