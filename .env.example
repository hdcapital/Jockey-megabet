# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Database -------------------------------------------------------------
# SQLite default; for PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/megabet
#DATABASE_URL=sqlite:///data/megabet.db

# --- Betfair Exchange API (optional benchmark; leave unset to disable) ----
# Create an app key at https://developer.betfair.com (My Account -> API keys).
#BETFAIR_APP_KEY=
#BETFAIR_USERNAME=
#BETFAIR_PASSWORD=
# Optional non-interactive (certificate) login:
#BETFAIR_CERT_FILE=/path/to/client-2048.crt
#BETFAIR_KEY_FILE=/path/to/client-2048.key
# Australian/NZ accounts live on identitysso.betfair.com.au. The scanner tries
# the configured host first and then the other region, logging which one
# accepted the login; pin it here to skip the first attempt:
#BETFAIR_IDENTITY_URL=https://identitysso.betfair.com.au
#BETFAIR_IDENTITY_CERT_URL=https://identitysso-cert.betfair.com.au
# Diagnose the connection step by step:  python -m app.betfair_check

# --- Model configuration --------------------------------------------------
# De-vig method for Sportsbet win markets: proportional | power | shin
#DEVIG_METHOD=proportional
# Consensus weights (renormalised; Betfair excluded automatically when
# unavailable or illiquid):
#CONSENSUS_WEIGHT_BETFAIR=0.7
#CONSENSUS_WEIGHT_SPORTSBET=0.3
# Betfair reliability gates:
#BETFAIR_MIN_LIQUIDITY=500
#BETFAIR_MAX_RELATIVE_SPREAD=0.25
# Delayed (free-tier) app keys report zero matched volume on every book, so
# the liquidity gate can never pass. auto = detect that per session and use
# spread-only reliability; true/false force it.
#BETFAIR_KEY_DELAYED=auto
#BETFAIR_DELAYED_MAX_RELATIVE_SPREAD=0.10

# --- Scanner behaviour ----------------------------------------------------
#SCAN_INTERVAL_SECONDS=180
#STALE_PRICE_SECONDS=600
#HTTP_MIN_REQUEST_INTERVAL_SECONDS=0.75
#ARCHIVE_RAW_RESPONSES=true

# --- Race value scanner (python -m app.race_value) ------------------------
# Sportsbet fixed win odds vs Betfair (source of truth), races jumping in the
# next VALUE_WINDOW_MINUTES, refreshed every VALUE_INTERVAL_SECONDS.
#VALUE_INTERVAL_SECONDS=60
#VALUE_WINDOW_MINUTES=20
#VALUE_BETFAIR_COUNTRIES=AU,NZ
# Commission on Betfair net winnings; only used for the back/lay "Lock" column.
#BETFAIR_COMMISSION=0.08
# Reliability gates (rows failing them are hidden unless --all):
#VALUE_MAX_RELATIVE_SPREAD=0.10
#VALUE_MIN_MATCHED=2000
#VALUE_MAX_BOOK_DEVIATION=0.05
#VALUE_SUSPECT_EV=0.30
#VALUE_MAX_SNAPSHOT_GAP_SECONDS=45
