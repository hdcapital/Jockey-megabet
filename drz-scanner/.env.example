# Copy to .env and edit. NEVER commit .env — it is in .gitignore.
# Every value here has a working default; you only need the ones you change.

# --- Bankroll and staking (display only; nothing is ever bet) --------------
BANKROLL=1000
KELLY_FRACTION=0.25
STAKE_CAP_PER_BET_PCT=0.01
STAKE_CAP_PER_RACE_PCT=0.02

# --- Scoring thresholds ---------------------------------------------------
DRZ_MIN=1.10              # BET threshold on p_place * place_price
DRZ_WATCH_MIN=1.03
DRZ_SUSPECT=1.30          # above this: never BET, log and archive
MAX_PRICE_AGE_SECONDS=60

# --- Maximum win price, per win model -------------------------------------
# The cap answers one question: out to what price are the win probabilities
# trustworthy? So it depends on where they came from.
#
# Measured on 44,856 AU thoroughbred races (Jan 2024 - Aug 2026), actual
# place rate / modelled place probability by win-price band:
#   (1,2] 0.97  (2,3] 0.98  (3,5] 0.99  (5,9] 1.00  (9,15] 1.03
#   (15,21] 1.02  (21,31] 1.00  (31,51] 1.00  (51,101] 0.99  (101+] 0.84
# Under Betfair prices the model is calibrated from about $3 to $51. The old
# 9.0 cutoff was only ever justified for Sportsbet-derived probabilities,
# where the longshot overround (not the place model) is what breaks down.
#
# This is a statement about the probabilities, NOT evidence that an edge
# exists at any price.
MAX_WIN_PRICE_BETFAIR=51.0
MAX_WIN_PRICE_SPORTSBET=9.0
MAX_WIN_PRICE_BETFAIR_DELAYED=21.0

# A BET must be confirmed by Betfair's own "To Be Placed" market. Measured
# over 436k runners, model-only signals priced against exchange place prices
# less a 10-15% margin returned 0.80-0.88 per $1 staked.
REQUIRE_EXCHANGE_CONFIRMATION=true

# --- Scope ------------------------------------------------------------------
# Only these countries are valued (the calibration is Australian-only; NZ
# shares Sportsbet's "Aus/NZ" class and is told apart on the racecard).
ALLOWED_COUNTRIES=["Australia"]
# On a full sweep, races further out than this are left for a later sweep.
RACECARD_HORIZON_MINUTES=180

# --- Scanner cadence ------------------------------------------------------
SCAN_INTERVAL_SECONDS=180        # full schedule sweep
NEAR_JUMP_INTERVAL_SECONDS=40    # races inside the near-jump window
NEAR_JUMP_WINDOW_SECONDS=600
HTTP_MIN_REQUEST_INTERVAL_SECONDS=0.75   # per-host politeness; do not lower

# --- Betfair (optional) ---------------------------------------------------
# Without these the scanner runs on Sportsbet alone and says so.
# A DELAYED application key works: the adapter detects the missing matched
# volume, switches to a spread-only gate, tags rows betfair_delayed, and
# refuses to let a delayed price alone make a BET inside 5 minutes of a jump.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Optional non-interactive certificate login instead of username/password:
# BETFAIR_CERT_FILE=client-2048.crt
# BETFAIR_KEY_FILE=client-2048.key
BETFAIR_MIN_LIQUIDITY=500
BETFAIR_MAX_RELATIVE_SPREAD=0.25
BETFAIR_DELAYED_MAX_RELATIVE_SPREAD=0.10
BETFAIR_DELAYED_NO_BET_WINDOW_SECONDS=300

# --- Storage --------------------------------------------------------------
# DATABASE_URL=sqlite:///data/drz.db
ARCHIVE_RAW_RESPONSES=true       # gzipped, under data/raw/<source>/<date>/
RAW_ARCHIVE_KEEP_DAYS=14         # older day-folders are deleted at startup
# LOG_DIR=data/logs              # daily-rotating drz.log, 14 days kept
